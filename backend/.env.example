# Copy to .env and fill in for local dev, or set these directly in
# Render/Fly's environment variable settings for deployment.

# MongoDB Atlas connection string. Get this from Atlas -> Connect -> Drivers.
# If unset, defaults to mongodb://localhost:27017 (a local Mongo instance).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=docflow

# Optional. If unset, extraction falls back to a heuristic/regex extractor
# so the demo runs with zero external dependencies.
ANTHROPIC_API_KEY=

# Set by the test suite automatically — don't set this yourself.
# MONGODB_MOCK=1
